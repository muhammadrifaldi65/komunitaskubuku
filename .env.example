# === Database (Neon) ===
# Ambil dari dashboard Neon: Connection string dengan mode "pooled"
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/bookclub?sslmode=require"
# Direct connection (non-pooled) - dipakai saat migrate
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/bookclub?sslmode=require"

# === NextAuth ===
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-string-yang-panjang"
NEXTAUTH_URL="http://localhost:3000"

# === Resend (kirim email OTP) ===
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="BookClub <onboarding@resend.dev>"

# === ImageKit ===
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
